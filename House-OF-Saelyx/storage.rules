rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isRootAdmin() {
      return isSignedIn() && request.auth.token.email == 'saelyxe.co@gmail.com';
    }

    function isVerifiedStaffAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        (
          request.auth.token.admin == true ||
          request.auth.token.role == 'admin' ||
          request.auth.token.role == 'super_admin'
        );
    }

    function isAdmin() {
      return isRootAdmin() || isVerifiedStaffAdmin();
    }

    function validImageUpload() {
      return request.resource != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }

    match /saelyxe/products/{uid}/{fileName=**} {
      allow read: if true;
      allow create: if isAdmin() && request.auth.uid == uid && validImageUpload();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /saelyxe/settings/{uid}/{fileName=**} {
      allow read: if true;
      allow create: if isAdmin() && request.auth.uid == uid && validImageUpload();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
