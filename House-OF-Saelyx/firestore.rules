rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.email == 'saelyx.co@gmail.com' ||
        request.auth.token.email == 'saelyx.co+super@gmail.com' ||
        request.auth.token.email == 'saelyx.co+admin@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.email == 'saelyx.co@gmail.com' ||
        request.auth.token.email == 'saelyx.co+super@gmail.com' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isStaff() {
      return isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /orders/{orderId} {
      // Orders are created by the trusted server/API using Firebase Admin SDK.
      allow create: if false;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'shippingAddress', 'customerName', 'phone', 'address', 'city', 'postalCode', 'country'
        ])
      );
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'displayName', 'photoURL', 'avatarUrl', 'phoneNumber', 'address', 'city',
          'postalCode', 'country', 'savedAddresses', 'updatedAt', 'lastLoginAt'
        ])
      );
      allow delete: if isSuperAdmin();
    }

    match /subscribers/{subscriberId} {
      allow create: if
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254;
      allow read, update, delete: if isAdmin();
    }

    match /stock_notifications/{notificationId} {
      allow create: if
        request.resource.data.productId is string &&
        request.resource.data.productId.size() <= 100 &&
        request.resource.data.customerEmail is string &&
        request.resource.data.customerEmail.size() <= 254 &&
        (!('customerName' in request.resource.data) || request.resource.data.customerName.size() <= 120) &&
        (!('phone' in request.resource.data) || request.resource.data.phone.size() <= 30);
      allow read, update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow create: if
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    match /concierge_inquiries/{inquiryId} {
      allow create: if
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if isStaff();
      allow create, update, delete: if isSuperAdmin();
    }

    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /audit_logs/{logId} {
      allow create, read: if isAdmin();
      allow update, delete: if isSuperAdmin();
    }
  }
}
