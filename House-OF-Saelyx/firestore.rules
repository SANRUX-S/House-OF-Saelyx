rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasVerifiedEmail() {
      return isAuthenticated() && request.auth.token.email_verified == true && request.auth.token.email is string;
    }

    function isBootstrapRootAdmin() {
      return hasVerifiedEmail() &&
        request.auth.token.email == 'saelyx.co@gmail.com';
    }

    function hasActiveAdminRecord() {
      return hasVerifiedEmail() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'active' &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.email == request.auth.token.email;
    }

    function isAdmin() {
      return isBootstrapRootAdmin() || (
        hasVerifiedEmail() && (
          request.auth.token.email == 'saelyx.co+admin@gmail.com' ||
          (hasActiveAdminRecord() && (
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin' ||
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin'
          ))
        )
      );
    }

    function isSuperAdmin() {
      return isBootstrapRootAdmin() || (
        hasVerifiedEmail() &&
        hasActiveAdminRecord() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    function isStaff() {
      return isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      // Product mutations are validated and audited by the trusted API.
      allow create, update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // Customer reviews are securely validated, rate-limited, and purchase-verified by the server API.
      allow create, update, delete: if false;
    }

    match /settings/{settingId} {
      allow read: if true;
      // Settings mutations are Super-Admin validated by the trusted API.
      allow create, update, delete: if false;
    }

    match /orders/{orderId} {
      // Orders are created by the trusted server/API using Firebase Admin SDK.
      allow create: if false;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      // All order mutations are trusted-server only. Customers must use protected API routes.
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == 'patron' &&
        (!('ordersCount' in request.resource.data) || request.resource.data.ordersCount == 0) &&
        request.resource.data.keys().hasOnly([
          'uid', 'name', 'firstName', 'lastName', 'displayName', 'email', 'phoneNumber', 'role', 'avatarUrl', 'photoURL',
          'address', 'city', 'postalCode', 'country', 'savedAddresses', 'authProvider',
          'joinedDate', 'ordersCount', 'createdAt', 'updatedAt', 'lastLoginAt'
        ]);
      // Users may update only their own non-identity profile fields.
      // Privileged user-management mutations must go through the trusted API.
      allow update: if isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'firstName', 'lastName', 'displayName', 'photoURL', 'avatarUrl', 'phoneNumber', 'address', 'city',
          'postalCode', 'country', 'savedAddresses', 'updatedAt', 'lastLoginAt'
        ]);
      allow delete: if false;
    }

    match /subscribers/{subscriberId} {
      allow read: if isAdmin();
      // Subscription mutations are trusted-server only.
      allow create, update, delete: if false;
    }

    match /stock_notifications/{notificationId} {
      allow read: if isAdmin();
      // Waitlist creation, delivery state changes, and deletion are trusted-server only.
      allow create, update, delete: if false;
    }

    match /messages/{messageId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /concierge_inquiries/{inquiryId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /staff/{staffId} {
      allow read: if isStaff();
      // Provisioning and revocation are server-only so Auth and Firestore stay consistent.
      allow create, update, delete: if false;
    }

    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      // Administrator provisioning and privilege changes are server-only.
      allow create, update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      // Audit entries are generated by the trusted server from verified tokens.
      allow create, update, delete: if false;
    }

    match /security_rate_limits/{docId} {
      allow read, write: if false;
    }

    match /order_idempotency/{docId} {
      allow read, write: if false;
    }

    match /guest_order_access/{docId} {
      // Guest checkout capability tokens are issued and validated only by the trusted API.
      allow read, write: if false;
    }

    match /restock_dispatch_locks/{docId} {
      allow read, write: if false;
    }
  }
}
