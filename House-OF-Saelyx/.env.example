# SAELYX Environment Configuration
PORT=3000
NODE_ENV=development

# Firebase client/server configuration
FIREBASE_API_KEY=replace-with-your-firebase-api-key
VITE_FIREBASE_API_KEY=replace-with-your-firebase-api-key
VITE_FIREBASE_PROJECT_ID=replace-with-your-project-id
VITE_FIREBASE_AUTH_DOMAIN=replace-with-your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_ID=ai-studio-saelyxmadeforpre-9fd90c38-837e-435e-b027-e53891c99a41
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=replace-with-your-app-id
VITE_FIREBASE_OAUTH_CLIENT_ID=
VITE_FIREBASE_ENABLE_REALTIME=true

# Server-side Firebase Admin SDK credentials (never expose these as VITE_* values)
FIREBASE_PROJECT_ID=replace-with-your-project-id
FIREBASE_CLIENT_EMAIL=replace-with-firebase-admin-sdk-client-email
FIREBASE_PRIVATE_KEY="replace-with-firebase-admin-sdk-private-key"

# PayPal public client identifier
VITE_PAYPAL_CLIENT_ID=replace-with-paypal-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-client-secret
PAYPAL_MODE=sandbox

PAYPAL_CLIENT_ID=replace-with-paypal-client-id

# Transactional email (server/Firebase Functions only; never expose as VITE_*)
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=SAELYXE <orders@your-verified-domain.com>

# Cloudinary media storage (server-only signing credentials)
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
